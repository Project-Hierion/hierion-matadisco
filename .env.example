# Matadisco Producer Environment Variables
# Copy this file to .env and fill in your values

# AT Protocol Authentication
# Your PDS endpoint (self-hosted or bsky.social)
MATADISCO_PDS_URL=https://bsky.social
# Your handle (e.g., project-hierion.org)
MATADISCO_HANDLE=your-handle-here
# App password (generate in PDS settings)
MATADISCO_APP_PASSWORD=your-app-password-here

# Optional: Rate Limit Configuration
# Minimum delay between publishes in seconds (for spreading)
MATADISCO_MIN_DELAY=1.0
# Maximum delay between publishes in seconds
MATADISCO_MAX_DELAY=5.0

# Optional: Dry Run Mode
# Set to true to preview records without publishing
MATADISCO_DRY_RUN=false

# Optional: Logging
# Log level (DEBUG, INFO, WARNING, ERROR)
MATADISCO_LOG_LEVEL=INFO
